AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
MONGODB_URI=

# The real deployed URL (no trailing slash) — used for og/twitter share-card
# links, sitemap.xml, and robots.txt. Falls back to localhost if unset, so
# this only needs setting once the production domain is known.
NEXT_PUBLIC_SITE_URL=

# AI assistant (Part 2) — free key from https://aistudio.google.com. Required
# for /api/chat to work at all; without it, chat requests fail at call time.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional overrides — sensible defaults are baked in if unset.
GEMINI_MODEL=gemini-3.6-flash
AI_DAILY_LIMIT_PER_USER=15
AI_DAILY_LIMIT_GLOBAL=1200

# Email+password sign-up (Part 1) — free key from https://app.brevo.com
# (Settings → SMTP & API → API keys; the regular API key, not the MCP one).
# BREVO_FROM_EMAIL must be a sender verified in that same Brevo account
# (Settings → Senders, domains, IPs) or sends are rejected.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
